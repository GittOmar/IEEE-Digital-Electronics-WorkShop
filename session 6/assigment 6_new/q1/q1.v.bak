module dual_port_ram#(parameter DATA_W = 16, ADDR_W = 4)
(
input clk, rst,
input [ADDR_W-1:0] addr_a, addr_b,
input [DATA_W-1:0] din_a, din_b,
input we_a, we_b,
output reg collision,
output reg [DATA_W-1:0] dout_a, dout_b
);

reg [DATA_W-1:0] mem [0:ADDR_W-1];
integer i;
always @(posedge clk )
begin
collision <=0;
begin
    if(rst)
    begin
        for(i = 0; i<ADDR_W; i = i+1)  mem[i] <=0;
        dout_a<=0;
        dout_b<=0;
    end
    else if(we_a || we_b) // memory access
    begin
        if(we_a && we_b) // double access
        begin 
            if(addr_a == addr_b) // collision
            begin 
                collision <=1;
                mem[addr_a]<=din_a;
                dout_a<=mem[addr_a];
            end
            else // no collision
            begin
                mem[addr_a]<=din_a;
                dout_a<=mem[addr_a];
                mem[addr_b]<=din_b;
                dout_b<=mem[addr_b];
            end
        end
        else // single access
        begin
            if(we_a)
            begin
                mem[addr_a]<=din_a;
                dout_a<=mem[addr_a];
            end
            if(we_b)
            begin
                mem[addr_b]<=din_b;
                dout_b<=mem[addr_b];
            end
        end
    end
end
end
endmodule